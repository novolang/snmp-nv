// snmp_text_tests.nv — object identifiers and values as text.

use std.test
use snmpber
use snmpoid
use snmppdu
use snmptext

fn oid_of(text: Str) -> SnmpOid
    var o = snmpoid.oid_empty()
    let _ok = snmpoid.oid_parse(var o, text)
    o

// The text of a binding of the given kind, number and span.
fn shown(kind: Int, num: Int, var pool: snmpber.SnmpBuf, off: Int, len: Int) -> Str
    var p = snmppdu.pdu_new(snmppdu.SNMP_PDU_RESPONSE, 1)
    var o = oid_of("1.3.6.1.2.1.1.1.0")
    let _ok = snmppdu.add(var p, var o, kind, num, off, len)
    snmptext.value_text(var pool, p.vbs[0])

@test
fn test_object_identifiers_as_text() [io]
    var o = oid_of(".1.3.6.1.2.1.1.1.0")
    test.assert_eq(snmptext.oid_text(var o), "1.3.6.1.2.1.1.1.0")
    var e = snmpoid.oid_empty()
    test.assert_eq(snmptext.oid_text(var e), "")

@test
fn test_each_kind_of_value_as_text() [io]
    var pool: snmpber.SnmpBuf = Vec.new()
    test.case("the numbers")
    test.assert_eq(shown(snmppdu.SNMP_V_INTEGER, -7, var pool, 0, 0), "-7")
    test.assert_eq(shown(snmppdu.SNMP_V_COUNTER32, 4294967295, var pool, 0, 0), "4294967295")
    test.assert_eq(shown(snmppdu.SNMP_V_GAUGE32, 12, var pool, 0, 0), "12")
    test.assert_eq(shown(snmppdu.SNMP_V_TIMETICKS, 360000, var pool, 0, 0), "360000")
    test.case("a Counter64 is unsigned")
    test.assert_eq(shown(snmppdu.SNMP_V_COUNTER64, 5, var pool, 0, 0), "5")
    test.assert_eq(shown(snmppdu.SNMP_V_COUNTER64, -1, var pool, 0, 0), "18446744073709551615")
    test.assert_eq(shown(snmppdu.SNMP_V_COUNTER64, -9223372036854775807 - 1, var pool, 0, 0),
        "9223372036854775808")
    test.case("an IpAddress")
    test.assert_eq(shown(snmppdu.SNMP_V_IPADDRESS, 3232235777, var pool, 0, 0), "192.168.1.1")
    test.case("an octet string that is text, and one that is not")
    let off = snmppdu.pool_add_str(var pool, "Linux")
    test.assert_eq(shown(snmppdu.SNMP_V_OCTETS, 0, var pool, off, 5), "Linux")
    test.assert_eq(shown(snmppdu.SNMP_V_OPAQUE, 0, var pool, off, 2), "Li")
    var raw: snmpber.SnmpBuf = Vec.new()
    for x in [0x00, 0x1A, 0xFF, 0x7E]
        let _ok = snmpber.put_byte(var raw, x)
    test.assert_eq(shown(snmppdu.SNMP_V_OCTETS, 0, var raw, 0, 4), "00 1a ff 7e")
    test.assert_eq(shown(snmppdu.SNMP_V_OCTETS, 0, var raw, 0, 0), "")
    test.case("an object identifier, and one that cannot be read")
    var oo = oid_of("1.3.6.1.4.1.9")
    var opool: snmpber.SnmpBuf = Vec.new()
    let ooff = snmppdu.pool_add_oid(var opool, var oo)
    test.assert_eq(shown(snmppdu.SNMP_V_OID, 0, var opool, ooff, snmpoid.oid_content_len(var oo)),
        "1.3.6.1.4.1.9")
    var bad: snmpber.SnmpBuf = Vec.new()
    let _b = snmpber.put_byte(var bad, 0x86)
    test.assert_eq(shown(snmppdu.SNMP_V_OID, 0, var bad, 0, 1), "(unreadable object identifier)")
    test.case("the exceptions and NULL")
    test.assert_eq(shown(snmppdu.SNMP_V_NO_SUCH_OBJECT, 0, var pool, 0, 0), "noSuchObject")
    test.assert_eq(shown(snmppdu.SNMP_V_NO_SUCH_INSTANCE, 0, var pool, 0, 0), "noSuchInstance")
    test.assert_eq(shown(snmppdu.SNMP_V_END_OF_MIB_VIEW, 0, var pool, 0, 0), "endOfMibView")
    test.assert_eq(shown(snmppdu.SNMP_V_NULL, 0, var pool, 0, 0), "NULL")
