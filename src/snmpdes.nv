// snmpdes.nv — DES in cipher block chaining mode, for the privacy protocol
// of RFC 3414 section 8.
//
// This module takes and answers `Bytes`, which a microcontroller's runtime
// does not define, so it is one of the package's host modules.
//
// DES (FIPS 46-3) encrypts a block of 64 bits under a key of 56 bits, given
// as 8 octets whose low bits are parity and are ignored.  It is here
// because the User-based Security Model specifies `usmDESPrivProtocol`, and
// a deployed agent may offer nothing else.  A 56-bit key can be searched
// exhaustively; a new deployment uses AES (`snmpusm`).
//
// The implementation is the textbook one: the initial permutation, sixteen
// rounds of expansion, key mixing, eight substitution boxes and the P
// permutation, and the final permutation.  A block is held as two integers
// of 32 bits.  Its test is the known-answer vector of FIPS 81 and Rivest's
// chain, and the cipher block chaining mode of RFC 3414 section 8.1.1.

use std.bytes

// The initial permutation, FIPS 46-3 table IP.
const IP = [58, 50, 42, 34, 26, 18, 10, 2, 60, 52, 44, 36, 28, 20, 12, 4,
            62, 54, 46, 38, 30, 22, 14, 6, 64, 56, 48, 40, 32, 24, 16, 8,
            57, 49, 41, 33, 25, 17, 9, 1, 59, 51, 43, 35, 27, 19, 11, 3,
            61, 53, 45, 37, 29, 21, 13, 5, 63, 55, 47, 39, 31, 23, 15, 7]

// The final permutation, the inverse of IP.
const FP = [40, 8, 48, 16, 56, 24, 64, 32, 39, 7, 47, 15, 55, 23, 63, 31,
            38, 6, 46, 14, 54, 22, 62, 30, 37, 5, 45, 13, 53, 21, 61, 29,
            36, 4, 44, 12, 52, 20, 60, 28, 35, 3, 43, 11, 51, 19, 59, 27,
            34, 2, 42, 10, 50, 18, 58, 26, 33, 1, 41, 9, 49, 17, 57, 25]

// The expansion of a 32-bit half to 48 bits, table E.
const EXPAND = [32, 1, 2, 3, 4, 5, 4, 5, 6, 7, 8, 9, 8, 9, 10, 11, 12, 13,
                12, 13, 14, 15, 16, 17, 16, 17, 18, 19, 20, 21, 20, 21, 22, 23, 24, 25,
                24, 25, 26, 27, 28, 29, 28, 29, 30, 31, 32, 1]

// The permutation of the substitution output, table P.
const PERM = [16, 7, 20, 21, 29, 12, 28, 17, 1, 15, 23, 26, 5, 18, 31, 10,
              2, 8, 24, 14, 32, 27, 3, 9, 19, 13, 30, 6, 22, 11, 4, 25]

// The key's first permutation, table PC-1: 64 bits to 56.
const PC1 = [57, 49, 41, 33, 25, 17, 9, 1, 58, 50, 42, 34, 26, 18,
             10, 2, 59, 51, 43, 35, 27, 19, 11, 3, 60, 52, 44, 36,
             63, 55, 47, 39, 31, 23, 15, 7, 62, 54, 46, 38, 30, 22,
             14, 6, 61, 53, 45, 37, 29, 21, 13, 5, 28, 20, 12, 4]

// The key's second permutation, table PC-2: 56 bits to 48.
const PC2 = [14, 17, 11, 24, 1, 5, 3, 28, 15, 6, 21, 10,
             23, 19, 12, 4, 26, 8, 16, 7, 27, 20, 13, 2,
             41, 52, 31, 37, 47, 55, 30, 40, 51, 45, 33, 48,
             44, 49, 39, 56, 34, 53, 46, 42, 50, 36, 29, 32]

// How far each half of the key rotates before each round.
const SHIFTS = [1, 1, 2, 2, 2, 2, 2, 2, 1, 2, 2, 2, 2, 2, 2, 1]

// The eight substitution boxes, 64 entries each, row by row.
const SBOX = [14, 4, 13, 1, 2, 15, 11, 8, 3, 10, 6, 12, 5, 9, 0, 7,
              0, 15, 7, 4, 14, 2, 13, 1, 10, 6, 12, 11, 9, 5, 3, 8,
              4, 1, 14, 8, 13, 6, 2, 11, 15, 12, 9, 7, 3, 10, 5, 0,
              15, 12, 8, 2, 4, 9, 1, 7, 5, 11, 3, 14, 10, 0, 6, 13,
              15, 1, 8, 14, 6, 11, 3, 4, 9, 7, 2, 13, 12, 0, 5, 10,
              3, 13, 4, 7, 15, 2, 8, 14, 12, 0, 1, 10, 6, 9, 11, 5,
              0, 14, 7, 11, 10, 4, 13, 1, 5, 8, 12, 6, 9, 3, 2, 15,
              13, 8, 10, 1, 3, 15, 4, 2, 11, 6, 7, 12, 0, 5, 14, 9,
              10, 0, 9, 14, 6, 3, 15, 5, 1, 13, 12, 7, 11, 4, 2, 8,
              13, 7, 0, 9, 3, 4, 6, 10, 2, 8, 5, 14, 12, 11, 15, 1,
              13, 6, 4, 9, 8, 15, 3, 0, 11, 1, 2, 12, 5, 10, 14, 7,
              1, 10, 13, 0, 6, 9, 8, 7, 4, 15, 14, 3, 11, 5, 2, 12,
              7, 13, 14, 3, 0, 6, 9, 10, 1, 2, 8, 5, 11, 12, 4, 15,
              13, 8, 11, 5, 6, 15, 0, 3, 4, 7, 2, 12, 1, 10, 14, 9,
              10, 6, 9, 0, 12, 11, 7, 13, 15, 1, 3, 14, 5, 2, 8, 4,
              3, 15, 0, 6, 10, 1, 13, 8, 9, 4, 5, 11, 12, 7, 2, 14,
              2, 12, 4, 1, 7, 10, 11, 6, 8, 5, 3, 15, 13, 0, 14, 9,
              14, 11, 2, 12, 4, 7, 13, 1, 5, 0, 15, 10, 3, 9, 8, 6,
              4, 2, 1, 11, 10, 13, 7, 8, 15, 9, 12, 5, 6, 3, 0, 14,
              11, 8, 12, 7, 1, 14, 2, 13, 6, 15, 0, 9, 10, 4, 5, 3,
              12, 1, 10, 15, 9, 2, 6, 8, 0, 13, 3, 4, 14, 7, 5, 11,
              10, 15, 4, 2, 7, 12, 9, 5, 6, 1, 13, 14, 0, 11, 3, 8,
              9, 14, 15, 5, 2, 8, 12, 3, 7, 0, 4, 10, 1, 13, 11, 6,
              4, 3, 2, 12, 9, 5, 15, 10, 11, 14, 1, 7, 6, 0, 8, 13,
              4, 11, 2, 14, 15, 0, 8, 13, 3, 12, 9, 7, 5, 10, 6, 1,
              13, 0, 11, 7, 4, 9, 1, 10, 14, 3, 5, 12, 2, 15, 8, 6,
              1, 4, 11, 13, 12, 3, 7, 14, 10, 15, 6, 8, 0, 5, 9, 2,
              6, 11, 13, 8, 1, 4, 10, 7, 9, 5, 0, 15, 14, 2, 3, 12,
              13, 2, 8, 4, 6, 15, 11, 1, 10, 9, 3, 14, 5, 0, 12, 7,
              1, 15, 13, 8, 10, 3, 7, 4, 12, 5, 6, 11, 0, 14, 9, 2,
              7, 11, 4, 1, 9, 12, 14, 2, 0, 6, 10, 13, 15, 3, 5, 8,
              2, 1, 14, 7, 4, 10, 8, 13, 15, 12, 9, 0, 3, 5, 6, 11]

// A 64-bit block as two halves of 32 bits each.
struct Block
    hi: Int
    lo: Int

// The bit `t` of a block, counting from 1 at the most significant bit of
// the high half.
fn bit_of(b: Block, t: Int) -> Int
    if t <= 32
        return (b.hi >> (32 - t)) & 1
    (b.lo >> (64 - t)) & 1

// Permute a block of 64 bits by a table of 64 entries.
fn permute64(b: Block, table: [Int]) -> Block
    var hi = 0
    var lo = 0
    for i in 0..32
        hi = hi * 2 + bit_of(b, table[i])
        lo = lo * 2 + bit_of(b, table[32 + i])
    Block { hi: hi, lo: lo }

// Permute the `bits` low bits of `v` by a table whose entries count from 1
// at the most significant of them.
fn permute(v: Int, table: [Int], bits: Int) -> Int
    var out = 0
    for t in table
        out = out * 2 + ((v >> (bits - t)) & 1)
    out

// The sixteen round keys of 48 bits for a key of 8 octets.
fn schedule(key: Bytes) -> [Int]
    let b = Block { hi: bytes.u32_be_at(key, 0) ?? 0, lo: bytes.u32_be_at(key, 4) ?? 0 }
    var k56 = 0
    for t in PC1
        k56 = k56 * 2 + bit_of(b, t)
    var c = k56 >> 28
    var d = k56 & 0xFFFFFFF
    var keys: [Int] = []
    for r in 0..16
        let n = SHIFTS[r]
        c = ((c << n) | (c >> (28 - n))) & 0xFFFFFFF
        d = ((d << n) | (d >> (28 - n))) & 0xFFFFFFF
        list.push(keys, permute((c << 28) | d, PC2, 56))
    keys

// The round function: expand the right half, mix in the key, substitute
// and permute.
fn feistel(r: Int, key: Int) -> Int
    let x = permute(r, EXPAND, 32) ^ key
    var s = 0
    for i in 0..8
        let six = (x >> (42 - 6 * i)) & 63
        let row = ((six >> 4) & 2) | (six & 1)
        let col = (six >> 1) & 15
        s = s * 16 + SBOX[i * 64 + row * 16 + col]
    permute(s, PERM, 32)

// One block through the sixteen rounds, with the round keys in the order
// given.
fn crypt_block(b: Block, keys: [Int]) -> Block
    let p = permute64(b, IP)
    var l = p.hi
    var r = p.lo
    for i in 0..16
        let next = l ^ feistel(r, keys[i])
        l = r
        r = next
    permute64(Block { hi: r, lo: l }, FP)

// The round keys in the opposite order, for decrypting.
fn reversed(keys: [Int]) -> [Int]
    var out: [Int] = []
    for i in 0..16
        list.push(out, keys[15 - i])
    out

// Encrypt one 8-octet block under an 8-octet key.  Answers `None` when
// either has another length.
//
// FIPS 81 gives the key 133457799BBCDFF1 and the plaintext
// 0123456789ABCDEF, and the ciphertext 85E813540F0AB405.
//
// ```novo
// use std.bytes
// use snmpdes
//
// fn main() [io]
//     let key = bytes.from_hex("133457799BBCDFF1") ?? bytes.zeros(0)
//     let plain = bytes.from_hex("0123456789ABCDEF") ?? bytes.zeros(0)
//     println(bytes.to_hex(snmpdes.encrypt_block(key, plain) ?? bytes.zeros(0)))   // 85e813540f0ab405
// ```
pub fn encrypt_block(key: Bytes, block: Bytes) -> ?Bytes
    if bytes.len(key) != 8 or bytes.len(block) != 8
        return None
    let out = crypt_block(Block { hi: bytes.u32_be_at(block, 0) ?? 0, lo: bytes.u32_be_at(block, 4) ?? 0 },
        schedule(key))
    Some(bytes.concat([bytes.u32_be(out.hi), bytes.u32_be(out.lo)]))

// Decrypt one 8-octet block under an 8-octet key.  Answers `None` when
// either has another length.
//
// ```novo
// use std.bytes
// use snmpdes
//
// fn main() [io]
//     let key = bytes.from_hex("133457799BBCDFF1") ?? bytes.zeros(0)
//     let cipher = bytes.from_hex("85E813540F0AB405") ?? bytes.zeros(0)
//     println(bytes.to_hex(snmpdes.decrypt_block(key, cipher) ?? bytes.zeros(0)))   // 0123456789abcdef
// ```
pub fn decrypt_block(key: Bytes, block: Bytes) -> ?Bytes
    if bytes.len(key) != 8 or bytes.len(block) != 8
        return None
    let out = crypt_block(Block { hi: bytes.u32_be_at(block, 0) ?? 0, lo: bytes.u32_be_at(block, 4) ?? 0 },
        reversed(schedule(key)))
    Some(bytes.concat([bytes.u32_be(out.hi), bytes.u32_be(out.lo)]))

// Encrypt `data` in cipher block chaining mode under an 8-octet key and an
// 8-octet initialisation vector (RFC 3414 section 8.1.1.2).  The data is
// padded with zero octets to a multiple of 8; the pad is not marked,
// because the scoped PDU carries its own length.  Answers `None` for a key
// or vector of another length.
//
// ```novo
// use std.bytes
// use snmpdes
//
// fn main() [io]
//     let key = bytes.from_hex("0123456789ABCDEF") ?? bytes.zeros(0)
//     let iv = bytes.zeros(8)
//     let c = snmpdes.cbc_encrypt(key, iv, bytes.from_str("abc")) ?? bytes.zeros(0)
//     println("${bytes.len(c)}")   // 8
// ```
pub fn cbc_encrypt(key: Bytes, iv: Bytes, data: Bytes) -> ?Bytes
    if bytes.len(key) != 8 or bytes.len(iv) != 8
        return None
    let keys = schedule(key)
    let padded = bytes.concat([data, bytes.zeros((8 - bytes.len(data) % 8) % 8)])
    var chain = Block { hi: bytes.u32_be_at(iv, 0) ?? 0, lo: bytes.u32_be_at(iv, 4) ?? 0 }
    var parts: [Bytes] = []
    for i in 0..bytes.len(padded) / 8
        let hi = bytes.u32_be_at(padded, i * 8) ?? 0
        let lo = bytes.u32_be_at(padded, i * 8 + 4) ?? 0
        chain = crypt_block(Block { hi: hi ^ chain.hi, lo: lo ^ chain.lo }, keys)
        list.push(parts, bytes.concat([bytes.u32_be(chain.hi), bytes.u32_be(chain.lo)]))
    Some(bytes.concat(parts))

// Decrypt `data` in cipher block chaining mode.  `data` must be a multiple
// of 8 octets; any other length, and a key or vector of another length,
// answer `None`.  The pad that `cbc_encrypt` added is still at the end.
//
// ```novo
// use std.bytes
// use snmpdes
//
// fn main() [io]
//     let key = bytes.from_hex("0123456789ABCDEF") ?? bytes.zeros(0)
//     let iv = bytes.zeros(8)
//     let c = snmpdes.cbc_encrypt(key, iv, bytes.from_str("abc")) ?? bytes.zeros(0)
//     let p = snmpdes.cbc_decrypt(key, iv, c) ?? bytes.zeros(0)
//     println(bytes.to_hex(p))   // 6162630000000000
// ```
pub fn cbc_decrypt(key: Bytes, iv: Bytes, data: Bytes) -> ?Bytes
    if bytes.len(key) != 8 or bytes.len(iv) != 8 or bytes.len(data) % 8 != 0
        return None
    let keys = reversed(schedule(key))
    var chain = Block { hi: bytes.u32_be_at(iv, 0) ?? 0, lo: bytes.u32_be_at(iv, 4) ?? 0 }
    var parts: [Bytes] = []
    for i in 0..bytes.len(data) / 8
        let hi = bytes.u32_be_at(data, i * 8) ?? 0
        let lo = bytes.u32_be_at(data, i * 8 + 4) ?? 0
        let p = crypt_block(Block { hi: hi, lo: lo }, keys)
        list.push(parts, bytes.concat([bytes.u32_be(p.hi ^ chain.hi), bytes.u32_be(p.lo ^ chain.lo)]))
        chain = Block { hi: hi, lo: lo }
    Some(bytes.concat(parts))
