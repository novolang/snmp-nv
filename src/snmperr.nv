// snmperr.nv — the refusals a message, an object identifier or a call can
// meet, and the error-status codes of RFC 3416.
//
// `[]` THROUGHOUT and `@tier(embedded)` on all of it.  An error is an
// integer, so a reader that fails costs no allocation and a device can
// carry the code in a register.  `error_text` turns one into a sentence
// for a program that logs.

// No fault: 0.
pub const SNMP_OK = 0
// The bytes stop before the value they announce: 1.
pub const SNMP_E_TRUNCATED = 1
// A tag other than the one the position allows: 2.
pub const SNMP_E_BAD_TAG = 2
// A length that is not definite, or does not fit its container: 3.
pub const SNMP_E_BAD_LENGTH = 3
// An INTEGER, Counter or Gauge wider than its type: 4.
pub const SNMP_E_BAD_INTEGER = 4
// An OBJECT IDENTIFIER that is empty, has an arc over 2^32 - 1 or a first
// arc pair that cannot be packed: 5.
pub const SNMP_E_BAD_OID = 5
// An OBJECT IDENTIFIER of more arcs than `SNMP_OID_MAX`: 6.
pub const SNMP_E_OID_TOO_LONG = 6
// A variable-binding list longer than `SNMP_VARBINDS_MAX`: 7.
pub const SNMP_E_TOO_MANY_VARBINDS = 7
// A message version this package does not read: 8.
pub const SNMP_E_BAD_VERSION = 8
// A PDU that is not one of the types the version allows, or is built
// wrongly: 9.
pub const SNMP_E_BAD_PDU = 9
// The output buffer is full: 10.
pub const SNMP_E_NO_ROOM = 10
// An IpAddress that is not four octets, or a value kind that is not
// known: 11.
pub const SNMP_E_BAD_VALUE = 11
// An argument that is out of range: 12.
pub const SNMP_E_BAD_ARGUMENT = 12
// A v3 flags octet with a reserved combination, such as privacy without
// authentication (RFC 3412 section 6.4): 13.
pub const SNMP_E_BAD_FLAGS = 13
// A security model other than the User-based Security Model, 3: 14.
pub const SNMP_E_BAD_SECURITY_MODEL = 14
// A msgSecurityParameters value that is not the sequence of RFC 3414
// section 2.4: 15.
pub const SNMP_E_BAD_SECURITY_PARAMS = 15
// A v3 message whose size limit or identifier is out of range: 16.
pub const SNMP_E_BAD_HEADER = 16
// Authentication failed: the digest does not match (RFC 3414 section
// 3.2 step 6): 17.
pub const SNMP_E_WRONG_DIGEST = 17
// The message is outside the time window of RFC 3414 section 2.2.3: 18.
pub const SNMP_E_NOT_IN_TIME_WINDOW = 18
// The decrypted scoped PDU is not a sequence: 19.
pub const SNMP_E_DECRYPT = 19
// The session was given a message that answers nothing it sent: 20.
pub const SNMP_E_UNEXPECTED = 20
// The call is not valid in the state the session is in: 21.
pub const SNMP_E_WRONG_STATE = 21

// The sentence for an error code.
//
// ```novo
// use snmperr
//
// fn main() [io]
//     println(snmperr.error_text(snmperr.SNMP_E_TRUNCATED))   // the message ends before a value it announces does
// ```
pub @tier(embedded)
@no_alloc
fn error_text(code: Int) -> Str []
    match code
        0  => "no fault"
        1  => "the message ends before a value it announces does"
        2  => "a tag that the position does not allow"
        3  => "a length that is not definite or does not fit its container"
        4  => "an integer wider than its type"
        5  => "an object identifier that cannot be read"
        6  => "an object identifier of more arcs than this package holds"
        7  => "more variable bindings than this package holds"
        8  => "an SNMP version that is not read here"
        9  => "a PDU that the message version does not allow"
        10 => "the output buffer is full"
        11 => "a value that is not of a known kind"
        12 => "an argument out of range"
        13 => "msgFlags with a reserved combination"
        14 => "a security model other than the User-based Security Model"
        15 => "msgSecurityParameters that are not the sequence of RFC 3414 section 2.4"
        16 => "a message header with a size limit or identifier out of range"
        17 => "the authentication digest does not match"
        18 => "the message is outside the time window"
        19 => "the decrypted scoped PDU is not a sequence"
        20 => "a message that answers nothing that was sent"
        21 => "the call is not valid in this state"
        _  => "an unknown error code"

// The error-status values of RFC 3416 section 3 and RFC 1157 section 4.1.1.
// noError: 0.
pub const SNMP_NO_ERROR = 0
// tooBig: 1.
pub const SNMP_TOO_BIG = 1
// noSuchName: 2, the v1 answer for a name that does not exist.
pub const SNMP_NO_SUCH_NAME = 2
// badValue: 3.
pub const SNMP_BAD_VALUE = 3
// readOnly: 4.
pub const SNMP_READ_ONLY = 4
// genErr: 5.
pub const SNMP_GEN_ERR = 5
// noAccess: 6.
pub const SNMP_NO_ACCESS = 6
// wrongType: 7.
pub const SNMP_WRONG_TYPE = 7
// wrongLength: 8.
pub const SNMP_WRONG_LENGTH = 8
// wrongEncoding: 9.
pub const SNMP_WRONG_ENCODING = 9
// wrongValue: 10.
pub const SNMP_WRONG_VALUE = 10
// noCreation: 11.
pub const SNMP_NO_CREATION = 11
// inconsistentValue: 12.
pub const SNMP_INCONSISTENT_VALUE = 12
// resourceUnavailable: 13.
pub const SNMP_RESOURCE_UNAVAILABLE = 13
// commitFailed: 14.
pub const SNMP_COMMIT_FAILED = 14
// undoFailed: 15.
pub const SNMP_UNDO_FAILED = 15
// authorizationError: 16.
pub const SNMP_AUTHORIZATION_ERROR = 16
// notWritable: 17.
pub const SNMP_NOT_WRITABLE = 17
// inconsistentName: 18.
pub const SNMP_INCONSISTENT_NAME = 18

// The name RFC 3416 gives an error-status value, or `unknown` for a
// number it does not define.
//
// ```novo
// use snmperr
//
// fn main() [io]
//     println(snmperr.error_status_name(snmperr.SNMP_NOT_WRITABLE))   // notWritable
// ```
pub @tier(embedded)
@no_alloc
fn error_status_name(status: Int) -> Str []
    match status
        0  => "noError"
        1  => "tooBig"
        2  => "noSuchName"
        3  => "badValue"
        4  => "readOnly"
        5  => "genErr"
        6  => "noAccess"
        7  => "wrongType"
        8  => "wrongLength"
        9  => "wrongEncoding"
        10 => "wrongValue"
        11 => "noCreation"
        12 => "inconsistentValue"
        13 => "resourceUnavailable"
        14 => "commitFailed"
        15 => "undoFailed"
        16 => "authorizationError"
        17 => "notWritable"
        18 => "inconsistentName"
        _  => "unknown"
